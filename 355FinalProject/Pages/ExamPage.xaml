<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="_355FinalProject.Pages.ExamPage"
             Title="ExamPage">
    <VerticalStackLayout>
        <Label 
            Text="Question 1: " />
        <Label
            Text="Consider The Following Associative Array:" />
        <Image
            Source="question1.png"
            MaximumWidthRequest="100"
            MaximumHeightRequest="200" />


        <RadioButton x:Name="q1A" Content="Max" GroupName="Q1"/>
        <RadioButton x:Name="q1B" Content="'name' => 'Max'" GroupName="Q1"/>
        <RadioButton x:Name="q1C" Content="Gabbie" GroupName="Q1"/>
        <RadioButton x:Name="q1D" Content="'name' => 'Gabbie'" GroupName="Q1"/>
        <RadioButton x:Name="q1E" Content="Dan" GroupName="Q1"/>
        <RadioButton x:Name="q1F" Content="'name' => 'Dan'" GroupName="Q1"/>



        <Label 
            Text="Question 2: " />
        <Label
            Text="Consider The Following Code:" />
        <Image
            Source="question2.png"
            MaximumWidthRequest="100"
            MaximumHeightRequest="200" />

        <Label
            Text="What is the Value of $equals?" />
        <RadioButton x:Name="q2A" Content="10" GroupName="Q2"/>
        <RadioButton x:Name="q2B" Content="True" GroupName="Q2"/>
        <RadioButton x:Name="q2C" Content="False" GroupName="Q2"/>
        <RadioButton x:Name="q2D" Content="15" GroupName="Q2"/>

        
        
        <Label 
            Text="Question 3: " />
        <Label
            Text="Select all Vaild PHP Variables:" />

        <HorizontalStackLayout>
            <CheckBox x:Name="chk1" />
            <Label Text="number = 5" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <HorizontalStackLayout>
            <CheckBox x:Name="chk2" />
            <Label Text="$number = 5" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <HorizontalStackLayout>
            <CheckBox x:Name="chk3" />
            <Label Text="$5number = 5" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <HorizontalStackLayout>
            <CheckBox x:Name="chk4" />
            <Label Text="$_number = 5" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <HorizontalStackLayout>
            <CheckBox x:Name="chk5" />
            <Label Text="$number-5 = 5" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <HorizontalStackLayout>
            <CheckBox x:Name="chk6" />
            <Label Text="$number_5 = 5" VerticalOptions="Center" />
        </HorizontalStackLayout>



        <Label
            Text="Question 4: " />

        <Label
            Text="Select all Valid Ways of Embedding a PHP tag Into HTML: " />

        <HorizontalStackLayout>
            <CheckBox x:Name="chk7" />
            <Label Text="'&lt;'php'&lt;' '&lt;'/php'&lt;'" VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <HorizontalStackLayout>
            <CheckBox x:Name="chk8" />
            <Label Text="'&lt;'?php ?'&lt;'" VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <HorizontalStackLayout>
            <CheckBox x:Name="chk9" />
            <Label Text="'&lt;'?= ?'&lt;'" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <HorizontalStackLayout>
            <CheckBox x:Name="chk10" />
            <Label Text="'&lt;'php= '&lt;'" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <HorizontalStackLayout>
            <CheckBox x:Name="chk11" />
            <Label Text="'&lt;'?php= ?'&lt;'" VerticalOptions="Center" />
        </HorizontalStackLayout>


        <Label Text="Question 5: " />
        <Label Text="Using the following loop, how many times will 'CITA 355' be printed?" />
        <Image
            Source="question2.png"
            MaximumWidthRequest="100"
            MaximumHeightRequest="200" />

        <Picker x:Name="answerPicker" Title="Pick an Answer">
            <Picker.Items>
                <x:String>4</x:String>
                <x:String>5</x:String>
                <x:String>6</x:String>
                <x:String>7</x:String>
            </Picker.Items>
        </Picker>


        <Button
            Text="Submit Exam"
             Clicked="SubmitExam_Clicked"/>


    </VerticalStackLayout>
</ContentPage>