<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="_355FinalProject.Pages.LoginPage"
             Title="LoginPage">
    
    <VerticalStackLayout>
        <HorizontalStackLayout>
            <Label
                Text="Email: " />
            <Entry
                x:Name="EmailEntry" 
                Placeholder="person@email.com"
                Keyboard="Email"/>
        </HorizontalStackLayout>
        <HorizontalStackLayout>
            <Label
                Text="Password: " />
            <Entry
                x:Name="PasswordEntry"
                Placeholder="person@email.com"
                Keyboard="Password"/>
        </HorizontalStackLayout>
        <Button
            Text="Clear Form"
            Clicked="ClearFormClicked" />
        <Button
            Text="Log In"
            Clicked="LoginClicked" />
    </VerticalStackLayout>
</ContentPage>